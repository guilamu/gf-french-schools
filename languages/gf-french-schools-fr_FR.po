msgid "Gravity Forms - French Schools requires Gravity Forms %s or higher."
msgstr "Gravity Forms - Écoles françaises nécessite Gravity Forms %s ou supérieur."

#: gf-french-schools.php
msgid "Once Monthly"
msgstr "Une fois par mois"

#: gf-french-schools.php
